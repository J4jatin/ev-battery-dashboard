# Base URL of the FastAPI backend. The WebSocket URL is derived from this
# automatically (http -> ws, https -> wss), so it is only configured once.
#
# Local development:
VITE_API_URL=http://localhost:8000
#
# Production (set this in the Vercel project settings, not in this file):
# VITE_API_URL=https://ev-battery-dashboard-production.up.railway.app
